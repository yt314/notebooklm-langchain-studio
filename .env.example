# Copy to .env and fill in. Loaded automatically via python-dotenv.

# --- Chat model (default provider: Google Gemini) ---
GOOGLE_API_KEY=...
# Override the default chat model if you like. gemini-flash-latest currently
# resolves to a preview model with a very small free-tier daily quota (20
# requests/day) - gemini-2.5-flash has its own, larger quota.
# NOTEBOOKLM_CHAT_MODEL=google_genai:gemini-2.5-flash

# --- Embeddings (default provider: Cohere) ---
COHERE_API_KEY=...
# NOTEBOOKLM_EMBEDDING_PROVIDER=cohere
# NOTEBOOKLM_EMBEDDING_MODEL=embed-multilingual-v3.0

# --- Web search sources (stage 3) ---
FIRECRAWL_API_KEY=...

# --- LangSmith tracing (module 1.9, optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=mini-notebooklm

# --- Text-to-speech (module 2, ElevenLabs provider) ---
# ELEVENLABS_API_KEY=...
