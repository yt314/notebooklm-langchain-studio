# Copy to .env and fill in. Loaded automatically via python-dotenv.

# --- Chat model (default provider: Google Gemini) ---
GOOGLE_API_KEY=...
# Override the default chat model if you like. Note: free-tier Gemini quota
# (20 requests/day) is scoped to the GOOGLE CLOUD PROJECT and per model, not
# to the individual API key - a new key from the same project/account will
# NOT reset it. Either wait ~24h, enable billing on the project, or use a key
# from a genuinely different Google Cloud project.
# NOTEBOOKLM_CHAT_MODEL=google_genai:gemini-2.5-flash

# --- Embeddings (default provider: Cohere) ---
COHERE_API_KEY=...
# NOTEBOOKLM_EMBEDDING_PROVIDER=cohere
# NOTEBOOKLM_EMBEDDING_MODEL=embed-multilingual-v3.0

# --- Web search sources (stage 3) ---
FIRECRAWL_API_KEY=...

# --- LangSmith tracing (module 1.9, optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=mini-notebooklm

# --- Text-to-speech (module 2, ElevenLabs provider) ---
# ELEVENLABS_API_KEY=...
# TED_VOICE_ID=...          # from ElevenLabs Voice Library -> My Voices
# TTS_MODEL=eleven_v3       # the only ElevenLabs model with Hebrew support
# TTS_STABILITY=0.35        # 0.0 Creative .. 1.0 Robust

# --- TTS via Cloud Run relay (module 2.4, optional - filtered networks) ---
# TTS_PROVIDER=cloudrun
# TTS_SERVICE_URL=https://tts-service-....run.app
# TTS_SERVICE_SECRET=...    # from `openssl rand -hex 24`, set on the Cloud Run service too
